# =============================================================================
# /etc/mysql/my.cnf : MySQL 서버 기본 설정 (mysql 패키지가 설치)
#
# - 이 파일을 수정해도 패키지 업데이트 시 덮어쓰지 않습니다.
#   새 기본값은 /etc/mysql/my.cnf.rpmnew 로 저장되니 비교 후 반영하세요.
# - 서버:      systemctl enable --now mysqld
#   첫 기동 시 datadir 이 비어 있으면 자동으로 초기화합니다.
#   임시 root 비밀번호: grep 'temporary password' /data/mysql/logs/mysqld.err
#   아래 "초기화 시에만 적용" 구역은 첫 기동 전에 확정하세요 (이후 변경 불가).
# - 클라이언트: mysql, mysqldump 등은 이 파일의 [client] 설정을 자동으로 읽습니다.
# =============================================================================

[mysqld]
# --- 경로 ---
basedir                     = /opt/mysql
datadir                     = /data/mysql/data
tmpdir                      = /data/mysql/tmp
socket                      = /data/mysql/mysql.sock
pid-file                    = /data/mysql/mysqld.pid
port                        = 3306

# --- 초기화 시에만 적용 (첫 기동 이후 변경하면 서버가 기동되지 않음) ---
# 0: 대소문자 구분(Linux 기본), 1: 소문자로 저장·구분 안 함 (기존 서버와 맞출 것)
lower_case_table_names      = 0
innodb_page_size            = 16K

# --- 서버 식별 (복제 구성 시 서버마다 다르게) ---
server_id                   = 1

# --- 로그 ---
log-error                   = /data/mysql/logs/mysqld.err
slow_query_log              = ON
slow_query_log_file         = /data/mysql/logs/slow.log
long_query_time             = 1

# --- 바이너리 로그 ---
log_bin                     = /data/mysql/binlog/mysql-bin
binlog_expire_logs_seconds  = 604800
gtid_mode                   = ON
enforce_gtid_consistency    = ON

# --- 문자셋 ---
character_set_server        = utf8mb4
collation_server            = utf8mb4_0900_ai_ci

# --- 메모리 (서버 사양에 맞게 조정: 보통 물리 메모리의 50~70%) ---
#innodb_buffer_pool_size    = 4G

[client]
socket                      = /data/mysql/mysql.sock
port                        = 3306
