# 리눅스에서 실행/사용하는 파일은 Windows 에서 받아도 LF 유지
*.sh       text eol=lf
*.spec     text eol=lf
*.service  text eol=lf
*.cnf      text eol=lf
*.conf     text eol=lf
*.ini      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
Dockerfile text eol=lf
# PowerShell 스크립트는 UTF-8 BOM 포함 (Windows PowerShell 5.1 호환)
*.ps1      text eol=lf
